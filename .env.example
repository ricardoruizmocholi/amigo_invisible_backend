# Puerto de la API (Railway inyecta PORT automáticamente)
PORT=3001

# Dirección (o direcciones separadas por comas) desde la que se abre el frontend
# Local: http://localhost:5173
# Producción: https://khambu.ricardorm.es
CORS_ORIGIN=http://localhost:5173

# Archivo de la base de datos SQLite (por defecto: data/amigo-invisible.db)
# En Railway con volumen: /data/amigo-invisible.db
# DATABASE_PATH=/data/amigo-invisible.db

# Zona horaria para validar las fechas
TIME_ZONE=Europe/Madrid
